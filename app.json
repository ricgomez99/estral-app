{
  "expo": {
    "name": "estral-app",
    "slug": "estral-app",
    "scheme": "estralapp",
    "version": "1.0.0",
    "experiments": {
      "reactCompiler": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.estralapp",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This application needs access to your gallery to select pictures for your registered animals",
        "NSCameraUsageDescription": "This application needs access to the camera for taking pictures for your registered animals"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.estralapp",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.263196030335-dnv4cph079qlfiec6l6god1uo3vthq7a"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": ["./assets/notification_sounds/notification_sound.wav"],
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dd05d2f9-4ae1-4b9f-9cb2-6a5bf9b17b05"
      }
    },
    "owner": "ricgomez99"
  }
}
