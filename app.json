{
  "expo": {
    "name": "estral-app",
    "slug": "estral-app",
    "scheme": "estral-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.estralapp",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This application needs acess to your gallery to select pictures for your registered animals",
        "NSCameraUsageDescription": "This application needs access to the camera for taking pictures for your registered animals"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.estralapp"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd05d2f9-4ae1-4b9f-9cb2-6a5bf9b17b05"
      }
    },
    "owner": "ricgomez99"
  }
}
